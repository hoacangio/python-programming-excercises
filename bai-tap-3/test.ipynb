   "source": [
    "myList = [1, 2, 3, 4, 5, 6, 7, 8]\n",
    "\n",
    "pairs = [(myList[i], myList[i+1]) for i in range(0, len(myList)-1, 2)]\n",
    "\n",
    "if len(pairs) * 2 < len(myList):\n",
    "    pairs.append((myList[-1], -1))\n",
    "\n",
    "print(pairs)"
