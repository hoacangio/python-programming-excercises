# Xem quy ước biến môi trường tại docs/requirements.md và docs/functions/process_price_alerts.md
DATABASE_URL=sqlite:///data/portfolio.db
# Dùng khi chạy service "db" (PostgreSQL) trong docker-compose.yml:
# DATABASE_URL=postgresql+psycopg2://portfolio:portfolio@db:5432/portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio
TELEGRAM_BOT_TOKEN=
HTTP_TIMEOUT_SECONDS=10
