# Xem quy ước biến môi trường tại docs/requirements.md và docs/functions/process_price_alerts.md
DATABASE_URL=sqlite:///data/portfolio.db
TELEGRAM_BOT_TOKEN=
HTTP_TIMEOUT_SECONDS=10
# Hậu tố mã trên Yahoo Finance (HOSE: .VN). Để trống nếu mã đã có hậu tố.
YAHOO_SYMBOL_SUFFIX=.VN
BOT_INTERVAL_MINUTES=1
